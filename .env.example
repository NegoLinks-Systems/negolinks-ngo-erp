# ---------------------------------------------------------------------------
# NegoLinks NGO & Nonprofit Management ERP — environment reference
# Copy this file to .env and fill in every value. Never commit .env.
# ---------------------------------------------------------------------------

# --- App identity -----------------------------------------------------------
VITE_APP_NAME="NegoLinks NGO & Nonprofit Management ERP"
VITE_APP_SHORT_NAME="NGO ERP"
VITE_APP_SLUG=ngo
VITE_APP_URL=https://ngo.negolinks.com

# --- Supabase (Project Settings > API) --------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key is used ONLY by Edge Functions. Never place it in this file
# for a deployed frontend — set it as a Supabase Function secret instead:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=

# --- AI platform ------------------------------------------------------------
# Groq Cloud is the default provider. The key is stored encrypted in the
# database via Settings > AI Platform. Set it as an Edge Function secret only:
#   supabase secrets set GROQ_API_KEY=gsk_...
VITE_DEFAULT_AI_PROVIDER=groq

# --- Support contact shown in the app footer and help pages ------------------
VITE_SUPPORT_EMAIL=info@negolinks.com
VITE_SUPPORT_PHONE=+2348063337624
VITE_SUPPORT_WEBSITE=https://negolinks.com

# --- Optional -------------------------------------------------------------
# Public document verification base URL used inside generated QR codes.
VITE_VERIFY_BASE_URL=https://ngo.negolinks.com/verify
